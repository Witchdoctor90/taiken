{
  "name": "fakepos-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop emulator for Fake POS (TAI-20) - locations, tables, checks, add item, reset.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "al.taiken.fakepos-admin",
    "productName": "Fake POS Admin",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  }
}
