<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <!-- TAI-13: Taiken.ArchitectureTests' VisibilityTests recognizes AddXModule by its
         IServiceCollection parameter type. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    <!-- TAI-13: DemoVenueSeeder is an IHostedService; Taiken.Venues is a plain class library
         (Microsoft.NET.Sdk), so Hosting.Abstractions isn't pulled in by an SDK like Sdk.Web is. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
    <!-- TAI-14: Taiken.FakePsp.Tests drives Program.cs in-process via WebApplicationFactory. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- TAI-14: controls the session clock from tests (expiry) without real Task.Delay waits. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- TAI-12: static dependency-rule checks in Taiken.ArchitectureTests (visibility rule). -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="WolverineFx" Version="6.39.1" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.39.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.39.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.39.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.39.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
